      <Textbox Name="Detail">
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>A separate statsmodels check gave Holt–Winters errors of 11.28 and 17.00. At three months the growth adjustment scored 16.67, reversing their order.</Value>
                <Style>
