        <Height>0.45in</Height>
      </Textbox>
      <Textbox Name="CaseDetail">
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>One month ahead, Holt–Winters forecast 466 thousand passengers. Actual demand was 419 thousand, an overestimate of about 47 thousand.</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                  <Color>#17354A</Color>
                </Style>
              </TextRun>
